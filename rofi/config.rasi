configuration {
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
}

@theme "/dev/null"

/* ─────────── Colors ─────────── */
* {
    bg:           #00000088;
    bg-alt:       #00000055;
    fg:           #eeeeeeff;
    fg-muted:     #aaaaaaff;
    border:       #ffffff22;
    selected-bg:  #ffffff22;
    selected-fg:  #ffffffff;

    background-color: transparent;
    text-color: @fg;
}

/* ─────────── Window ─────────── */
window {
    transparency: "real";
    location: center;
    width: 500px;
    border-radius: 12px;
    border: 1px;
    border-color: @border;
    background-color: @bg;
    padding: 16px;
}

/* ─────────── Input ─────────── */
inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 8px;
    border-radius: 8px;
    background-color: @bg-alt;
}

prompt {
    text-color: @fg-muted;
}

entry {
    text-color: @fg;
}

/* ─────────── List ─────────── */
listview {
    lines: 8;
    spacing: 6px;
    scrollbar: false;
    margin: 10px 0px 0px 0px;
}

/* ─────────── Elements (rows) ─────────── */
element {
    padding: 8px;
    border-radius: 8px;
}

element normal.normal {
    background-color: transparent;
}

element normal.alternate {
    background-color: #ffffff08;
}

element selected.normal {
    background-color: @selected-bg;
}

element-text {
    text-color: @fg;
}

element-text selected.normal {
    text-color: @selected-fg;
}

/* ─────────── Icons ─────────── */
element-icon {
    size: 1.1em;
    margin: 0px 10px 0px 0px;
}

/* ─────────── Message / Error ─────────── */
message {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 8px;
}

