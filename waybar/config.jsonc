{
    "layer": "top",
    "position": "bottom",

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "battery",
        "custom/uptime",
        "tray",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{id}",
        "sort-by-number": true
    },

    "clock": {
        "timezone": "Europe/London",
        "format": "{:%d %b %H:%M:%S}",
        "interval": 1
    },

    "network": {
        "format-wifi": "NET {bandwidthDownBits}",
        "format-ethernet": "NET {bandwidthDownBits}",
        "format-disconnected": "NET OFF",
        "tooltip": false,
        "interval": 5
    },

    "cpu": {
        "interval": 1,
        "format": "CPU {usage}%"
    },

    "memory": {
        "interval": 5,
        "format": "RAM {used:0.1f}G"
    },

    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "CHR {capacity}%",
        "format-warning": "LOW {capacity}%",
        "format-critical": "CRIT {capacity}%"
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTE"
    },

    "custom/uptime": {
        "format": "{}",
        "exec": "uptime -p",
        "interval": 300
    },

    "tray": {
        "spacing": 8
    },

    "custom/power": {
        "format": "EXIT",
        "tooltip": false,
        "on-click": "wlogout"
    }
}
